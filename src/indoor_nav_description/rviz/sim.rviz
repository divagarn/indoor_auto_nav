Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar 3D
      Enabled: true
      Topic:
        Value: /points
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: RGBD cloud
      Enabled: true
      Topic:
        Value: /camera/rgbd/points
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
    - Class: rviz_default_plugins/Image
      Name: RGB
      Enabled: true
      Topic:
        Value: /camera/rgbd/image_raw
        Reliability Policy: Best Effort
  Enabled: true
